# VTEC — copy to .env.local and fill in. Never commit .env.local.

# ---- World IDKit: seat claim (Page 1) + human approval per submission (Page 2)
# developer.world.org -> your app -> World ID
NEXT_PUBLIC_WLD_APP_ID=          # app_...
WLD_RP_ID=                       # rp_...  (not the api_... team key)
RP_SIGNING_KEY=                  # 0x... server only, signs each IDKit request
WLD_PASS_ACTION=vtec-humanpass   # World ID action for the HumanPass (one proof per person, ever)
WLD_ENVIRONMENT=staging          # staging = World ID simulator, production = real World App
WLD_STAGING_TOKEN=               # sk_... from the 24h staging window (staging only)

# ---- Sui testnet: HumanPass, process fees, verifier draw, kernel licenses ------
# Public fullnodes speak gRPC only (JSON-RPC is off); the app uses gRPC.
# Filled in automatically by `bun scripts/publish-sui.ts`.
NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_SUI_PACKAGE_ID=
NEXT_PUBLIC_SUI_VAULT_ID=
NEXT_PUBLIC_SUI_MARKET_ID=
SUI_HUMANS_ID=
SUI_ADMIN_CAP_ID=
SUI_ADMIN_KEY=                   # suiprivkey... server only: mints HumanPasses, settles fees, lists kernels
NEXT_PUBLIC_FEE_SUI=0.01         # process fee per submission, paid after World ID (must match the vault)
NEXT_PUBLIC_LICENSE_SUI=0.1      # price of a kernel License: 70% tuner, 20% lineage, 10% platform

# ---- Verification ------------------------------------------------------------
VERIFIER_POOL_SIZE=5             # verifiers drawn per submission
VERIFIER_QUORUM=3                # how many must agree
PLATFORM_HARNESS=1               # platform runs the verifier agent when too few humans are in the pool
HARNESS_RUNS=3                   # timed runs per build for the platform harness

