# VTEC — copy to .env.local and fill in. Never commit .env.local.

# ---- World IDKit: Proof of Human, one tuner seat per person -----------------
# developer.world.org -> your app -> World ID
NEXT_PUBLIC_WLD_APP_ID=          # app_...
WLD_RP_ID=                       # rp_...  (not the api_... team key)
RP_SIGNING_KEY=                  # 0x... server only, signs each IDKit request
NEXT_PUBLIC_WLD_ACTION=claim-tuner-seat
WLD_ENVIRONMENT=staging          # staging = World ID simulator, production = real World App

# ---- World ID for Agents: human approves each agent submission --------------
# OIDC client from the sandbox portal. Uses the device flow, so no redirect URL.
WA_ISSUER=https://sandbox.auth.world.org
WA_CLIENT_ID=
WA_CLIENT_SECRET=

# ---- Chain: Ethereum Sepolia (escrow + ENSv2) — next phase ------------------
SEPOLIA_RPC_URL=
NEXT_PUBLIC_CHAIN_ID=11155111
DEPLOYER_KEY=
ATTESTER_KEY=
NEXT_PUBLIC_ESCROW_ADDR=

# ---- ENSv2 on Sepolia — next phase ------------------------------------------
ENS_PARENT_NAME=vtec.eth
ENS_OWNER_KEY=
