# GPU VTEC - local development. Copy to .env and fill in.
# Section 0 rule 4: secrets stay server-side. Nothing here reaches the browser
# except what services/api/src/config.ts publicConfig() explicitly allows.

# ---- chain -----------------------------------------------------------------
GPUVTEC_RPC_URL=http://127.0.0.1:8545
GPUVTEC_CHAIN_ID=31337
GPUVTEC_REGISTRY=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Pays gas only. Holds no authority: it cannot sign a report, issue a permit,
# or approve a release. Anvil account 0 by default.
GPUVTEC_RELAYER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ---- api -------------------------------------------------------------------
GPUVTEC_API_PORT=8787
GPUVTEC_DB=.data/api.sqlite
GPUVTEC_WEB_ORIGIN=http://127.0.0.1:3000
GPUVTEC_BRIDGE_URL=http://127.0.0.1:8788

# ---- identity bridge -------------------------------------------------------
# A SEPARATE process, because it holds the permit key and nothing else should.
GPUVTEC_BRIDGE_PORT=8788
GPUVTEC_BRIDGE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# Development escape hatch. With this on, the bridge signs permits WITHOUT any
# identity journey, so the release lifecycle can be built and demonstrated before
# World access exists. Every permit is stamped kind:"dev-stub" and the UI shows
# it. Section 11's cut rule: do not substitute a mock for prize eligibility.
GPUVTEC_BRIDGE_DEV_ATTEST=1

# ---- World IDP (section 9) -------------------------------------------------
# Set all four to switch the bridge out of dev-stub and into a real journey.
# Until then the bridge reports IDP_UNAVAILABLE and says what is missing.
# Do NOT guess these values - section 0 rule 3: read the official docs first.
# GPUVTEC_WORLD_ISSUER=
# GPUVTEC_WORLD_CLIENT_ID=
# GPUVTEC_WORLD_CLIENT_SECRET=
# GPUVTEC_WORLD_REDIRECT_URI=

# ---- consumer (runtime/consumer) -------------------------------------------
GPUVTEC_PROJECT=gpu-vtec/sha256
GPUVTEC_CHANNEL=stable
GPUVTEC_API_URL=http://127.0.0.1:8787
GPUVTEC_REFRESH_MS=30000
# GPUVTEC_ARTIFACT=artifacts/releases/kernel.ptx
# Scope-policy test: makes this consumer report a different driver, so a
# correctly scoped release is correctly refused. Labelled on screen.
# GPUVTEC_PRETEND_DRIVER=999.99
